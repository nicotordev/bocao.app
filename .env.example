# Copy to .env and adjust. Never commit .env.

# PostgreSQL — paste your provider connection string (Neon, Supabase, RDS, local, etc.)
DATABASE_URL="postgresql://bocao:bocao@localhost:5433/bocao?schema=public"

# Better Auth — https://www.better-auth.com/docs/installation
# BETTER_AUTH_SECRET=   # generate: bunx auth@latest secret
# BETTER_AUTH_URL="http://localhost:3000"

# App
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_DEFAULT_TIMEZONE="America/Santiago"

# Demo seed (`bun run db:seed:demo`) — comma-separated emails and/or domains
# ADMIN_EMAILS="you@example.com,@yourcompany.com,partner.com"
# DEMO_ORGANIZATION_SLUG="bocao-demo"
# DEMO_ORGANIZATION_NAME="Bocao Demo"

# Resend — https://resend.com/docs/send-with-nextjs
# RESEND_API_KEY=
# EMAIL_FROM="Bocao <onboarding@resend.dev>"

# Redis (kitchen realtime pub/sub, future queues)
# REDIS_URL="redis://localhost:6379"

# Kitchen WebSocket gateway (started with `bun dev` via concurrently)
# KITCHEN_REALTIME_SECRET=   # generate: openssl rand -base64 32
# KITCHEN_WS_PORT=3001
# NEXT_PUBLIC_KITCHEN_WS_URL="ws://localhost:3001"

# OpenAI (AI replies / copilot / marketing / analytics cron)
# OPENAI_API_KEY=
# OPENAI_MARKETING_MODEL=gpt-4.1-mini
# OPENAI_ANALYTICS_MODEL=gpt-4.1-mini

# Cron jobs (analytics insights refresh)
# CRON_SECRET=   # generate: openssl rand -base64 32
# Schedule: GET /api/cron/analytics-insights with Authorization: Bearer $CRON_SECRET

# Meta WhatsApp Cloud API
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_VERIFY_TOKEN=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_APP_SECRET=
# TODO: per-restaurant credentials in DB; routes inbound webhooks for now
# META_WHATSAPP_RESTAURANT_ID=

# Stripe (billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 Storage (profile picture uploads, etc.)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

