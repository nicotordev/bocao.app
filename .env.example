# Copy to .env and adjust. Never commit .env.

# PostgreSQL — paste your provider connection string (Neon, Supabase, RDS, local, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Redis (queues / cache — add when wiring BullMQ or similar)
# REDIS_URL="redis://localhost:6379"

# OpenAI (AI replies / copilot)
# OPENAI_API_KEY=

# Meta WhatsApp Cloud API
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Stripe (billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# App
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js v5 (Auth.js) — https://authjs.dev/getting-started/installation
# AUTH_SECRET=   # generate: openssl rand -base64 32
# AUTH_URL="http://localhost:3000"
