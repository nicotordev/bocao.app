// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  RESTAURANT
  BAR
  CAFE
  DARK_KITCHEN
  OTHER
}

enum PrimaryGoal {
  ORDERS
  RESERVATIONS
  WHATSAPP
  MENU
}

/// Billing / tenancy root. One org can own many restaurants (locations).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// ISO 3166-1 alpha-2, e.g. CL, MX
  country   String   @default("CL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants  Restaurant[]
  memberships  Membership[]
  roles        Role[]
  customerTags CustomerTag[]
}

/// Staff user. Email is unique across the app.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Global permission catalog (seeded from code, not user-defined).
model Permission {
  id          String   @id @default(cuid())
  /// e.g. "menu:read", "orders:write"
  key         String   @unique
  description String?
  /// UI grouping: "menu", "orders", "staff"
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

/// Role scoped to an organization. System roles cannot be deleted.
model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Links a user to an organization with a role (row-level multi-tenant access).
model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId         String
  organizationId String
  roleId         String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleId])
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
  OTHER
  MANUAL_PENDING
}

enum PaymentProvider {
  MANUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DiningTableShape {
  ROUND
  SQUARE
  RECT
}

enum ProductFlowBlockType {
  CHOICE
  MULTI_CHOICE
  QUANTITY
  TEXT
  INFO
  UPSELL
}

enum FlowLibraryScope {
  CATEGORY
  MENU_ITEM
}

enum KitchenStationCategory {
  GRILL
  FRYER
  SUSHI
  BAR
  DESSERTS
  DELIVERY
  PREP
  OTHER
}

/// Restaurant (location) operating under an organization.
model Restaurant {
  id             String        @id @default(cuid())
  name           String
  city           String?
  phone          String?
  businessType   BusinessType?
  primaryGoal    PrimaryGoal?
  serviceModes   OrderType[]   @default([])
  /// IANA timezone, e.g. America/Santiago
  timezone       String        @default("America/Santiago")
  /// ISO 4217, e.g. CLP, MXN, COP
  currency       String        @default("CLP")
  /// BCP 47 / ISO 639-1 codes enabled for menu and flow translations
  contentLocales String[]      @default(["es", "en"])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customers             Customer[]
  customerSavedSegments CustomerSavedSegment[]
  menuCategories        MenuCategory[]
  menuItems             MenuItem[]
  orders                Order[]
  reservations          Reservation[]
  diningSurfaces        DiningSurface[]
  menuCustomTags        MenuCustomTag[]
  dbTranslations        DbTranslation[]
  productFlowBlocks     ProductFlowBlock[]
  productFlowTemplates  ProductFlowTemplate[]
  productPurchaseFlows  ProductPurchaseFlow[]
  kitchenStations       KitchenStation[]
  marketingCampaigns    MarketingCampaign[]

  @@index([organizationId])
}

/// AI-generated marketing campaign draft or saved copy for a restaurant.
model MarketingCampaign {
  id           String  @id @default(cuid())
  tenantId     String
  restaurantId String
  createdById  String?

  goal     String
  channel  String
  tone     String
  audience String

  productName String?
  promotion   String?
  input       Json
  output      Json

  status String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([tenantId, restaurantId, createdAt])
  @@index([restaurantId, channel])
}

/// Operational kitchen prep station configured per restaurant.
model KitchenStation {
  id                  String                 @id @default(cuid())
  restaurantId        String
  name                String
  description         String                 @default("")
  category            KitchenStationCategory
  /// User-defined label when category is OTHER.
  customCategoryLabel String?
  imageUrl            String?
  /// Menu tag icon key used when no custom image is set.
  iconId              String?
  isActive            Boolean                @default(true)
  sortOrder           Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
}

/// Configurable dining area with a custom polygon boundary and table layout.
model DiningSurface {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String   @default("Salón principal")
  /// Floor level number, e.g. 1 = ground floor, 2 = second floor.
  floor         Int      @default(1)
  /// Real-world area in square meters entered by the user.
  surfaceAreaM2 Float
  /// Polygon vertices as normalized coordinates [{x,y}] in 0..1 space.
  boundary      Json
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     DiningTable[]

  @@index([restaurantId])
}

/// Table placed on a dining surface with a visible number for operations.
model DiningTable {
  id        String           @id @default(cuid())
  surfaceId String
  /// Operational label shown on the floor plan, e.g. "12".
  number    String
  shape     DiningTableShape @default(ROUND)
  capacity  Int              @default(4)
  /// Normalized position (0..1) within the surface bounding box.
  positionX Float
  positionY Float
  rotation  Float            @default(0)
  /// Normalized size relative to canvas width/height.
  width     Float            @default(0.08)
  height    Float            @default(0.08)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  surface DiningSurface @relation(fields: [surfaceId], references: [id], onDelete: Cascade)

  @@unique([surfaceId, number])
  @@index([surfaceId])
}

model Customer {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String?
  phone        String?
  /// National ID document (e.g. RUT in Chile)
  documentId   String?
  address      String?
  notes        String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant          Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderLinks          OrderCustomer[]
  reservations        Reservation[]
  savedSegmentMembers CustomerSavedSegmentMember[]
  tagAssignments      CustomerTagAssignment[]

  @@index([restaurantId])
  @@index([email])
  @@index([phone])
  @@index([documentId])
}

model CustomerSavedSegment {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  members    CustomerSavedSegmentMember[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model CustomerSavedSegmentMember {
  id         String   @id @default(cuid())
  segmentId  String
  customerId String
  createdAt  DateTime @default(now())

  segment  CustomerSavedSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([segmentId, customerId])
  @@index([customerId])
  @@index([segmentId])
}

/// Account-wide customer tags shared across all workspaces/locations.
model CustomerTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  CustomerTagAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CustomerTagAssignment {
  customerId String
  tagId      String
  createdAt  DateTime @default(now())

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
}

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant           Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items                MenuItem[]
  productFlowBlocks    ProductFlowBlock[]
  productFlowTemplates ProductFlowTemplate[]

  @@index([restaurantId])
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  priceCents   Int
  sortOrder    Int      @default(0)
  /// Product labels with optional icon, stored as JSON objects
  tags         Json     @default("[]")
  /// Public image URLs for this menu item
  images       String[] @default([])
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant           Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category             MenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  purchaseFlow         ProductPurchaseFlow?
  productFlowBlocks    ProductFlowBlock[]
  productFlowTemplates ProductFlowTemplate[]

  @@index([restaurantId])
  @@index([categoryId])
}

/// Reusable purchase-flow block scoped to a category or menu item.
model ProductFlowBlock {
  id           String               @id @default(cuid())
  restaurantId String
  scopeType    FlowLibraryScope
  categoryId   String?
  menuItemId   String?
  /// Stable key within the scope, e.g. size, extras
  key          String
  type         ProductFlowBlockType
  /// Block config: labels, options, rules, pricing
  config       Json
  sortOrder    Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, scopeType, categoryId, menuItemId, key])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([menuItemId])
}

/// Reusable purchase-flow template scoped to a category or menu item.
model ProductFlowTemplate {
  id           String           @id @default(cuid())
  restaurantId String
  scopeType    FlowLibraryScope
  categoryId   String?
  menuItemId   String?
  name         String
  description  String?
  /// Ordered flow steps as JSON
  steps        Json
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([categoryId])
  @@index([menuItemId])
}

/// Optional purchase-flow attached to a menu item.
model ProductPurchaseFlow {
  id           String   @id @default(cuid())
  restaurantId String
  menuItemId   String   @unique
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  /// Ordered flow steps as JSON
  steps        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// Restaurant-defined menu tag metadata (icon, stable key).
model MenuCustomTag {
  id           String   @id @default(cuid())
  restaurantId String
  /// Stable tag key, e.g. custom-porcion-familiar
  key          String
  icon         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@index([restaurantId])
}

/// Generic database-backed translations scoped to a restaurant.
model DbTranslation {
  id           String   @id @default(cuid())
  restaurantId String
  /// Entity namespace, e.g. menu_custom_tag
  entityType   String
  /// Stable key within the entity namespace
  entityKey    String
  /// BCP 47 language code, e.g. es, en
  locale       String
  /// Field name being translated, e.g. label
  field        String
  value        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, entityType, entityKey, locale, field])
  @@index([restaurantId, entityType])
  @@index([restaurantId, entityType, entityKey])
}

model OrderCustomer {
  orderId    String
  customerId String
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([orderId, customerId])
  @@index([customerId])
}

model Order {
  id              String      @id @default(cuid())
  restaurantId    String
  orderNumber     String
  /// Table or station label for dine-in orders, e.g. "12"
  tableNumber     String?
  status          OrderStatus @default(PENDING)
  type            OrderType   @default(DINE_IN)
  /// UI channel key, e.g. whatsapp, web, dineIn
  channel         String?
  /// Staff member responsible for the order
  assignedTo      String?
  totalCents      Int         @default(0)
  preparationMins Int?
  notes           String?
  /// Rich UI payload: items, summary, timeline, history
  details         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customers  OrderCustomer[]
  payments   Payment[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

/// Payment record for an order. Provider-agnostic; adapters map external PSP events later.
model Payment {
  id          String          @id @default(cuid())
  orderId     String
  method      PaymentMethod
  provider    PaymentProvider @default(MANUAL)
  status      PaymentStatus   @default(PENDING)
  amountCents Int
  currency    String
  /// External reference from a future PSP adapter (optional).
  externalRef String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  customerId   String?
  guestName    String
  guestPhone   String?
  guestCount   Int               @default(2)
  status       ReservationStatus @default(PENDING)
  scheduledAt  DateTime
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([scheduledAt])
  @@index([status])
}

/// Domain events persisted after successful mutations for audit and realtime fan-out.
model AppEventLog {
  id           String    @id @default(cuid())
  tenantId     String
  restaurantId String?
  domain       String
  type         String
  payload      Json
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([publishedAt])
}
