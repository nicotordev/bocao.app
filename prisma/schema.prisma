// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  RESTAURANT
  BAR
  CAFE
  DARK_KITCHEN
  OTHER
}

enum PrimaryGoal {
  ORDERS
  RESERVATIONS
  WHATSAPP
  MENU
}

/// Billing / tenancy root. One org can own many restaurants (locations).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// ISO 3166-1 alpha-2, e.g. CL, MX
  country   String   @default("CL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants Restaurant[]
  memberships Membership[]
  roles       Role[]
}

/// Staff user. Email is unique across the app.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Global permission catalog (seeded from code, not user-defined).
model Permission {
  id          String   @id @default(cuid())
  /// e.g. "menu:read", "orders:write"
  key         String   @unique
  description String?
  /// UI grouping: "menu", "orders", "staff"
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

/// Role scoped to an organization. System roles cannot be deleted.
model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Links a user to an organization with a role (row-level multi-tenant access).
model Membership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId         String
  organizationId String
  roleId         String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Restaurant (location) operating under an organization.
model Restaurant {
  id           String        @id @default(cuid())
  name         String
  city         String?
  phone        String?
  businessType BusinessType?
  primaryGoal  PrimaryGoal?
  serviceModes OrderType[]   @default([])
  /// IANA timezone, e.g. America/Santiago
  timezone     String        @default("America/Santiago")
  /// ISO 4217, e.g. CLP, MXN, COP
  currency     String        @default("CLP")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customers      Customer[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  reservations   Reservation[]
  demoProfile    RestaurantDemoProfile?

  @@index([organizationId])
}

model Customer {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderLinks   OrderCustomer[]
  reservations Reservation[]

  @@index([restaurantId])
  @@index([email])
  @@index([phone])
}

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  priceCents   Int
  /// Public image URLs for this menu item
  images       String[] @default([])
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([categoryId])
}

model OrderCustomer {
  orderId    String
  customerId String
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([orderId, customerId])
  @@index([customerId])
}

model Order {
  id              String      @id @default(cuid())
  restaurantId    String
  orderNumber     String
  /// Table or station label for dine-in orders, e.g. "12"
  tableNumber     String?
  status          OrderStatus @default(PENDING)
  type            OrderType   @default(DINE_IN)
  /// UI channel key, e.g. whatsapp, web, dineIn
  channel         String?
  /// Staff member responsible for the order
  assignedTo      String?
  totalCents      Int         @default(0)
  preparationMins Int?
  notes           String?
  /// Rich UI payload: items, summary, timeline, history
  details         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customers  OrderCustomer[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

/// Demo-only dashboard extras seeded by `db:seed:demo` (insights, WhatsApp stats, team).
model RestaurantDemoProfile {
  restaurantId  String   @id
  insights      Json     @default("[]")
  orderInsights Json     @default("[]")
  whatsapp      Json     @default("{}")
  teamActivity  Json     @default("[]")
  metricTrends  Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Reservation {
  id           String            @id @default(cuid())
  restaurantId String
  customerId   String?
  guestName    String
  guestPhone   String?
  guestCount   Int               @default(2)
  status       ReservationStatus @default(PENDING)
  scheduledAt  DateTime
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([scheduledAt])
  @@index([status])
}
